# ============================================================================
# Session-Bound API Key Proxy - environment template
# Copy to `.env` (or export) and edit before boot.
# ----------------------------------------------------------------------------
# REQUIRED:
#   Path to seed file listing the key pool. Read only on first boot (fresh DB).
KEYS_FILE=./keys.json
#   Absolute path to the SQLite store. Persist this location on Render.
#   e.g. /var/data/proxy.db (mount a disk there)
DB_PATH=./data/proxy.db

# Upstream DeepSeek endpoint (do not change unless you have a reason).
UPSTREAM_URL=https://api.deepseek.com/v1/chat/completions

# Path the harness will call on this proxy.
PROXY_ENDPOINT=/v1/chat/completions

# Server port (Render sets $PORT automatically; uvicorn --port $PORT).
PORT=8000

# ----------------------------------------------------------------------------
# Tuning (defaults fine for most free-tier use).
# Session rows are GC'd after this much inactivity (bindings are still
# permanent while a session is active; this only removes dead rows).
SESSION_TTL_SECONDS=2592000
# Seconds a key is parked after a 429/capacity signal.
COOLDOWN_SECONDS=30
# Transient (5xx/network) retries on the SAME key, exponential backoff.
MAX_TRANSIENT_RETRIES=3
RETRY_BASE_DELAY=0.5
RETRY_MAX_DELAY=8.0

# ----------------------------------------------------------------------------
# SECURITY: set a strong value. All /admin/* endpoints require it.
ADMIN_TOKEN=CHANGE_ME_STRONG_RANDOM_VALUE

# Local dev convenience: bind to loopback.
BIND=127.0.0.1
